# Copiez ce fichier en `.env` (ou `.env.local`) — les deux sont ignorés par git.
# Sur Netlify : Site configuration → Environment variables.
# Les variables sont lues au BUILD (CRA) — changer une valeur = rebuild.
# Sans valeur, src/axios.js retombe sur le backend de production.

# URL de base du backend — SANS slash final, en HTTPS en production.
# Tous les services (auth, affectation, clm, juridique, bib, notifications,
# uploads) sont montés sur cette même base.
REACT_APP_API_URL=https://lexora.duckdns.org
# Backend local (si vous en lancez un) :
# REACT_APP_API_URL=http://localhost:8083

# Gateway historique (inutilisé — vaut REACT_APP_API_URL par défaut)
# REACT_APP_GATEWAY_URL=https://lexora.duckdns.org

# Clé de l'assistant IA (Groq, format gsk_…) — SECRET, côté serveur uniquement.
# ⚠ NE JAMAIS la préfixer par REACT_APP_ : CRA copierait la valeur dans le bundle
# JS public et n'importe quel visiteur pourrait la lire. Elle est lue par le proxy
# (fonction Netlify / setupProxy en dev), jamais par le code React.
# Voir AI_ASSISTANT_FEATURES.md §2.
AI_API_KEY=

# Interrupteur de l'assistant (booléen non secret → autorisé dans le bundle). `false` masque
# toutes les entrées IA de l'interface. Absent = activé.
# REACT_APP_AI_ENABLED=false

# Facultatif, côté serveur (proxy) : chaînes de modèles Groq, séparées par des virgules.
# Sur un quota dépassé (429) le proxy passe au modèle suivant de la chaîne.
# AI_MODELS_ASSISTANT=openai/gpt-oss-120b,openai/gpt-oss-20b
# AI_MODELS_PRECISE=openai/gpt-oss-120b,openai/gpt-oss-20b
# AI_MODELS_FAST=openai/gpt-oss-20b,openai/gpt-oss-120b
# AI_MODEL_STT=whisper-large-v3-turbo
